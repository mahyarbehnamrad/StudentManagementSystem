@model StudentManagementSystem.Models.ViewModels.StudentCourses.StudentCourseIndexViewModel
@{
    ViewData["Title"] = "Enrollments";
}
<div class="content-medium">
    <form method="get"
          asp-action="Index"
          class="student-course-filter">

        <input asp-for="SearchTerm"
               class="form-control"
               placeholder="Search student or course..." />

        <button type="submit"
                class="btn btn-primary">
            Search
        </button>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Clear
        </a>

    </form>
    <div class="table-card">
        <h2>Enrollments</h2>

        <a asp-action="Create"
           class="btn btn-primary mb-3">
            Enroll Student
        </a>

        @if (Model.StudentCourses.Any())
        {
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Course</th>
                        <th>Max Grade</th>
                        <th>Enrollment Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.StudentCourses)
                    {
                        <tr>
                            <td>@item.StudentName</td>

                            <td>@item.CourseName</td>

                            <td>@item.MaxGrade</td>

                            <td>
                                @item.CreatedAt.ToString("yyyy-MM-dd")
                            </td>

                            <td>
                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-danger btn-sm">
                                    Remove
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">

                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <h4>No enrollments found</h4>

                    <p>
                        No student or course matches your search.
                    </p>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Clear Search
                    </a>
                }
                else
                {
                    <h4>No enrollments yet</h4>

                    <p>
                        Enroll a student in a course to get started.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">
                        + Enroll Student
                    </a>
                }

            </div>
        }
    </div>
</div>