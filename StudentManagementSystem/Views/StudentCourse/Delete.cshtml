@model StudentManagementSystem.Models.ViewModels.StudentCourses.DeleteStudentCourseViewModel

@{
    ViewData["Title"] = "Remove Enrollment";
}
<div class="content-narrow">
    <h2>Remove Enrollment</h2>

    <div class="alert alert-danger">
        Are you sure you want to remove this enrollment?
    </div>

    <div class="card mb-3">

        <div class="card-body">

            <p>
                <strong>Student:</strong>
                @Model.StudentName
            </p>

            <p>
                <strong>Course:</strong>
                @Model.CourseName
            </p>

        </div>

    </div>

    <form asp-action="DeleteConfirmed"
          method="post">

        <input asp-for="Id"
               type="hidden" />

        <button type="submit"
                class="btn btn-danger">
            Remove
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>