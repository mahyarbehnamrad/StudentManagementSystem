@model StudentManagementSystem.Models.ViewModels.StudentCourses.CreateStudentCourseViewModel

@{
    ViewData["Title"] = "Enroll Student";
}
<div class="content-narrow">
<h2>Enroll Student</h2>

<form asp-action="Create"
      method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <div class="mb-3">

        <label asp-for="StudentId"
               class="form-label">
            Student
        </label>

        <select asp-for="StudentId"
                asp-items="Model.Students"
                class="form-select">

            <option value="0">
                -- Select Student --
            </option>

        </select>

        <span asp-validation-for="StudentId"
              class="text-danger">
        </span>

    </div>

    <div class="mb-3">

        <label asp-for="CourseId"
               class="form-label">
            Course
        </label>

        <select asp-for="CourseId"
                asp-items="Model.Courses"
                class="form-select">

            <option value="0">
                -- Select Course --
            </option>

        </select>

        <span asp-validation-for="CourseId"
              class="text-danger">
        </span>

    </div>

    <button type="submit"
            class="btn btn-primary">
        Enroll
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
</div>