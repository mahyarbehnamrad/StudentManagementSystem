@{
    ViewData["Title"] = "Home";
}

<div class="text-center mb-5">
    <h1 class="display-4">Student Management System</h1>
    <p class="text-muted">
        Manage students, courses, enrollments and grades.
    </p>
</div>

<div class="row g-4">


    <!-- Students -->
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body text-center">

                <h3 class="card-title">
                    Students
                </h3>

                <p class="card-text text-muted">
                    Manage student information and status.
                </p>

                <a asp-controller="Student"
                   asp-action="Index"
                   class="btn btn-primary">
                    Manage Students
                </a>

            </div>
        </div>
    </div>


    <!-- Courses -->
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body text-center">

                <h3 class="card-title">
                    Courses
                </h3>

                <p class="card-text text-muted">
                    Create and manage available courses.
                </p>

                <a asp-controller="Course"
                   asp-action="Index"
                   class="btn btn-success">
                    Manage Courses
                </a>

            </div>
        </div>
    </div>

    <!-- Enrollments -->
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body text-center">

                <h3 class="card-title">
                    Enrollments
                </h3>

                <p class="card-text text-muted">
                    Enroll students in courses and manage enrollments.
                </p>

                <a asp-controller="StudentCourse"
                   asp-action="Index"
                   class="btn btn-dark">
                    Manage Enrollments
                </a>

            </div>
        </div>
    </div>

    <!-- Grades -->
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body text-center">

                <h3 class="card-title">
                    Grades
                </h3>

                <p class="card-text text-muted">
                    Manage student grades and course results.
                </p>

                <a asp-controller="Grade"
                   asp-action="Index"
                   class="btn btn-warning">
                    Manage Grades
                </a>

            </div>
        </div>
    </div>
</div>