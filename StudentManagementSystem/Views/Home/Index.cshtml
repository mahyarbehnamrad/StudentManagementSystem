@model StudentManagementSystem.Models.ViewModels.Dashboard.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-page">

    <div class="dashboard-header">
        <h2>Dashboard</h2>

        <p>
            Overview of the Student Management System
        </p>
    </div>

    <div class="dashboard-grid">

        <a asp-controller="Student"
           asp-action="Index"
           class="dashboard-card">

            <div class="dashboard-card-title">
                Students
            </div>

            <div class="dashboard-number">
                @Model.StudentCount
            </div>

            <div class="dashboard-stat-label">
                Total students
            </div>

            <div class="dashboard-link">
                View Students →
            </div>

        </a>


        <a asp-controller="Course"
           asp-action="Index"
           class="dashboard-card">

            <div class="dashboard-card-title">
                Courses
            </div>

            <div class="dashboard-number">
                @Model.CourseCount
            </div>

            <div class="dashboard-stat-label">
                Total courses
            </div>

            <div class="dashboard-link">
                View Courses →
            </div>

        </a>


        <a asp-controller="StudentCourse"
           asp-action="Index"
           class="dashboard-card">

            <div class="dashboard-card-title">
                Enrollments
            </div>

            <div class="dashboard-number">
                @Model.EnrollmentCount
            </div>

            <div class="dashboard-stat-label">
                Active enrollments
            </div>

            <div class="dashboard-link">
                View Enrollments →
            </div>

        </a>


        <a asp-controller="Grade"
           asp-action="Index"
           class="dashboard-card">

            <div class="dashboard-card-title">
                Grades
            </div>

            <div class="dashboard-number">
                @Model.GradeCount
            </div>

            <div class="dashboard-stat-label">
                Recorded grades
            </div>

            <div class="dashboard-link">
                View Grades →
            </div>

        </a>

        <div class="dashboard-charts">

            <div class="chart-card">

                <div class="chart-header">
                    <h4>Student Status</h4>

                    <p>
                        Distribution of students by current status
                    </p>
                </div>

                <div class="chart-container">
                    <canvas id="studentStatusChart"></canvas>
                </div>

            </div>

        </div>

        <div class="chart-card">

            <div class="chart-header">
                <h4>Grade Performance</h4>

                <p>
                    Distribution of grades by percentage
                </p>
            </div>

            <div class="chart-container">
                <canvas id="gradePerformanceChart"></canvas>
            </div>

        </div>
    </div>

</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const studentStatusCanvas =
            document.getElementById('studentStatusChart');

        new Chart(studentStatusCanvas, {
            type: 'doughnut',

            data: {
                labels: [
                    'Active',
                    'Inactive',
                    'Graduated'
                ],

                datasets: [{
                    data: [
                        @Model.ActiveStudentCount,
                        @Model.InactiveStudentCount,
                        @Model.GraduatedStudentCount
                    ],

                    backgroundColor: [
                        '#4f8f70',
                        '#d77a7a',
                        '#668bc4'
                    ],

                    borderWidth: 0
                }]
            },

            options: {
                responsive: true,
                maintainAspectRatio: false,

                cutout: '68%',

                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });
                const gradePerformanceCanvas =
            document.getElementById('gradePerformanceChart');

        new Chart(gradePerformanceCanvas, {
            type: 'bar',

            data: {
                labels: [
                    'Below 50%',
                    '50% - 80%',
                    '80%+'
                ],

                datasets: [{
                    label: 'Grades',

                    data: [
                        @Model.LowGradeCount,
                        @Model.MediumGradeCount,
                        @Model.HighGradeCount
                    ],

                    backgroundColor: [
                        '#d77a7a',
                        '#d6a84b',
                        '#4f8f70'
                    ],

                    borderRadius: 7
                }]
            },

            options: {
                responsive: true,
                maintainAspectRatio: false,

                plugins: {
                    legend: {
                        display: false
                    }
                },

                scales: {
                    y: {
                        beginAtZero: true,

                        ticks: {
                            precision: 0
                        }
                    }
                }
            }
        });
    </script>
}