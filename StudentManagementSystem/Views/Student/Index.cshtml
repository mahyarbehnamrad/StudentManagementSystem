@using StudentManagementSystem.Models.Enums
@model StudentManagementSystem.Models.ViewModels.Students.StudentIndexViewModel

<div class="content-medium">
    <form method="get"
      asp-action="Index"
      class="student-filter">

    <input asp-for="SearchTerm"
           class="form-control"
           placeholder="Search by student name..." />

    <select asp-for="Status"
            asp-items="Html.GetEnumSelectList<StudentStatus>()"
            class="form-select">

        <option value="">
            All Statuses
        </option>

    </select>

    <button type="submit"
            class="btn btn-primary">
        Search
    </button>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        Clear
    </a>

</form>
<div class="table-card">
<h2>Students</h2>

<a asp-action="Create" class="btn btn-primary mb-3">
    Add Student
</a>

        @if (Model.Students.Any())
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Full Name</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var student in Model.Students)
                    {
                        <tr>
                            <td>@student.FullName</td>

                            @{
                                var statusClass = student.Status switch
                                {
                                    StudentStatus.Active => "bg-success",
                                    StudentStatus.Inactive => "bg-danger",
                                    StudentStatus.Graduated => "bg-primary",
                                    _ => "bg-secondary"
                                };
                            }

                            <td>
                                <span class="badge @statusClass">
                                    @student.Status
                                </span>
                            </td>

                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@student.Id"
                                   class="btn btn-info btn-sm">
                                    Details
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@student.Id"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@student.Id"
                                   class="btn btn-danger btn-sm">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">

                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) ||
                            Model.Status.HasValue)
                {
                    <h4>No students found</h4>

                    <p>
                        Try changing your search term or selected status.
                    </p>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Clear Filters
                    </a>
                }
                else
                {
                    <h4>No students yet</h4>

                    <p>
                        Add your first student to get started.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">
                        + Add Student
                    </a>
                }

            </div>
        }
</div>
</div>