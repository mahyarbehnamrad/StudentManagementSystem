@model StudentManagementSystem.Models.ViewModels.Students.DetailStudentViewModel
<div class="content-narrow">
<h2>Student Details</h2>

<div class="card">
    <div class="card-body">

        <h4 class="card-title">
            @Model.FullName
        </h4>

        <p>
            <strong>Email:</strong>
            @Model.Email
        </p>

        <p>
            <strong>Phone Number:</strong>
            @Model.PhoneNumber
        </p>

        <p>
            <strong>Status:</strong>
            @Model.Status
        </p>

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning">
            Edit
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>

    </div>
</div>
</div>