@model StudentManagementSystem.Models.ViewModels.Grades.EditGradeViewModel

@{
    ViewData["Title"] = "Edit Grade";
}
<div class="content-narrow">
<h2>Edit Grade</h2>

<form asp-action="Edit" method="post">

    <input asp-for="Id" type="hidden" />

    <input asp-for="StudentName" type="hidden" />
    <input asp-for="CourseName" type="hidden" />
    <input asp-for="MaxGrade" type="hidden" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <div class="mb-3">
        <strong>Student:</strong>
        @Model.StudentName
    </div>

    <div class="mb-3">
        <strong>Course:</strong>
        @Model.CourseName
    </div>

    <div class="mb-3">
        <strong>Maximum Grade:</strong>
        @Model.MaxGrade
    </div>

    <div class="mb-3">
        <label asp-for="Score"
               class="form-label">
            Score
        </label>

        <input asp-for="Score"
               class="form-control" />

        <span asp-validation-for="Score"
              class="text-danger">
        </span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Save Changes
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
</div>