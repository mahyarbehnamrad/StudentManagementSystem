@model List<StudentManagementSystem.Models.ViewModels.Grades.ListGradeViewModel>

@{
    ViewData["Title"] = "Grades";
}

<div class="content-wide">
<div class="table-card">
<h2>Grades</h2>

<a asp-action="Create" class="btn btn-primary mb-3">
    Add Grade
</a>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Student</th>
            <th>Course</th>
            <th>Score</th>
            <th>Max Grade</th>
            <th>Percentage</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
                @foreach (var item in Model)
                {
                    var gradeClass = item.Percentage < 50
                    ? "grade-low"
                    : item.Percentage < 75
                    ? "grade-medium"
                    : "grade-high";

                    <tr class="@gradeClass">
                        <td>@item.StudentName</td>
                        <td>@item.CourseName</td>
                        <td>@item.Score</td>
                        <td>@item.MaxGrade</td>

                        <td>
                            @if (item.Percentage < 50)
                            {
                                <span class="badge grade-badge-low">
                                    @item.Percentage.ToString("0.##")%
                                </span>
                            }
                            else if (item.Percentage < 75)
                            {
                                <span class="badge grade-badge-medium">
                                    @item.Percentage.ToString("0.##")%
                                </span>
                            }
                            else
                            {
                                <span class="badge grade-badge-high">
                                    @item.Percentage.ToString("0.##")%
                                </span>
                            }
                        </td>

                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-warning btn-sm">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-danger btn-sm">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
    </tbody>
</table>
    </div>
</div>