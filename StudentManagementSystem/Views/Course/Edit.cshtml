@model StudentManagementSystem.Models.ViewModels.Courses.EditCourseViewModel
<div class="content-narrow">
<h2>Edit Course</h2>

<form asp-action="Edit" method="post">

    <input asp-for="Id"
           type="hidden" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>

    <div class="mb-3">
        <label asp-for="Name"
               class="form-label">
        </label>

        <input asp-for="Name"
               class="form-control" />

        <span asp-validation-for="Name"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="MaxGrade"
               class="form-label">
        </label>

        <input asp-for="MaxGrade"
               class="form-control" />

        <span asp-validation-for="MaxGrade"
              class="text-danger">
        </span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Save Changes
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
</div>