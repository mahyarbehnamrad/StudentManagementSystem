@model StudentManagementSystem.Models.ViewModels.Courses.CourseIndexViewModel

<div class="content-medium">
    <form method="get"
          asp-action="Index"
          class="course-filter">

        <input asp-for="SearchTerm"
               class="form-control"
               placeholder="Search course..." />

        <button type="submit"
                class="btn btn-primary">
            Search
        </button>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Clear
        </a>

    </form>
<div class="table-card">
    <h2>Courses</h2>

    <a asp-action="Create"
       class="btn btn-primary mb-3">
        Add Course
    </a>

   @if (Model.Courses.Any())
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Max Grade</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var course in Model.Courses)
            {
                <tr>
                    <td>@course.Name</td>

                    <td>@course.MaxGrade</td>

                    <td>
                        <a asp-action="Details"
                           asp-route-id="@course.Id"
                           class="btn btn-info btn-sm">
                            Details
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@course.Id"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@course.Id"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="empty-state">

        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
        {
            <h4>No courses found</h4>

            <p>
                No course matches your search.
            </p>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Clear Search
            </a>
        }
        else
        {
            <h4>No courses yet</h4>

            <p>
                Add your first course to get started.
            </p>

            <a asp-action="Create"
               class="btn btn-primary">
                + Add Course
            </a>
        }

    </div>
}
</div>
</div>